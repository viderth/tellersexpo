<body>
<header><button id="back" class="back" hidden type="button">← Back</button><div class="brand">EXPO PREP LIST<small>TELLERS EXPO</small></div></header>
<main class="container">
<section id="shift-screen" class="panel" hidden>
<h2 style="text-align:center;margin:5px 0 0">What shift are you working?</h2>
<div id="day-buttons" class="days" aria-label="Choose day"></div>
<div class="shift-options"><button type="button" class="shift-opt" data-select-shift="AM">AM<span>Before 3:30 PM</span></button><button type="button" class="shift-opt" data-select-shift="PM">PM<span>From 3:30 PM</span></button></div>
<p class="small muted" style="text-align:center">Today and your shift are detected automatically. Choose another here.</p>
<button type="button" id="admin-from-picker" class="btn">Admin</button>
</section>
<section id="list-screen"><noscript><div class="panel">Please enable JavaScript in Chrome to use this prep list.</div></noscript>
<div class="panel"><div class="row"><div><div class="screen-title" id="shift-title"></div><div class="dayline" id="shift-date"></div></div><div class="toolbar"><button id="change-shift" class="btn tiny">Change day / shift</button><button id="admin-from-list" class="btn tiny">Admin</button></div></div></div>
<details class="panel" open id="specials-details"><summary>Specials</summary><div class="inner special-grid"><div id="daily-display" class="special"></div><div id="monthly-display" class="special"></div></div></details>
<details class="panel" open id="duties-details"><summary>Duties</summary><div class="inner"><section class="subsection"><h3>On Arrival</h3><div id="arrival-tasks"></div></section><section class="subsection"><h3>Check Out</h3><div id="checkout-tasks"></div></section></div></details>
<details class="panel" open id="prep-details"><summary>Stock / Prep</summary><div class="inner" id="prep-tasks"></div></details>
<button id="clear-checks" class="btn tiny">Clear checkmarks for this shift</button>
<p class="notice">Checkmarks and Admin edits in this prototype are saved in this browser only. Publishing on GitHub Pages does not automatically share edits or pictures between phones.</p>
</section>
<section id="admin-screen" hidden>
<div class="panel"><div class="row"><h2 style="margin:0">Admin</h2><button id="admin-done" class="btn tiny dark">Done</button></div><p class="small muted">Manage daily and monthly specials, prep items, and shift duties.</p><nav class="admin-nav"><button class="btn tiny dark" data-admin-tab="specials">Specials</button><button class="btn tiny" data-admin-tab="prep">Stock / Prep</button><button class="btn tiny" data-admin-tab="duties">Duties</button></nav>
<div id="admin-specials"><h3>Daily Special</h3><div id="admin-days" class="days admin-tabs"></div><div id="daily-editor"></div><div class="admin-section"><h3 id="month-title">Monthly Special</h3><div id="monthly-editor"></div></div></div>
<div id="admin-prep" hidden><p class="small muted">Regular items show every day. Brunch items show Saturday and Sunday only.</p><div id="prep-editor"></div><div class="admin-card"><h3>Add a prep item</h3><div class="form-grid"><label style="grid-column:1/-1">Item name<input id="new-item-name" class="field" maxlength="100" placeholder="New item"></label><label>Section<select id="new-item-section" class="field"></select></label><label>Par<input id="new-item-par" class="field" maxlength="45" placeholder="e.g. 1 pan"></label></div><label class="checkrow"><input type="checkbox" id="new-item-brunch"> Brunch only (Sat–Sun)</label><button type="button" id="add-item" class="btn red" style="margin-top:12px">+ Add prep item</button></div></div>
<div id="admin-duties" hidden><p class="small muted">Each shift has its own On Arrival and Check Out tasks.</p><div class="controls"><div class="control"><label for="duties-shift">Shift</label><select id="duties-shift" class="field"><option>AM</option><option>PM</option></select></div><div class="control"><label for="duties-type">Section</label><select id="duties-type" class="field"><option value="arrival">On Arrival</option><option value="checkout">Check Out</option></select></div></div><div id="duty-editor"></div><div class="admin-card"><h3>Add a duty</h3><input id="new-duty" class="field" maxlength="110" placeholder="New duty"><button id="add-duty" class="btn red" style="margin-top:10px">+ Add duty</button></div></div>
<p class="notice">Admin has no password in this local preview. Before putting it into staff use, shared saving and protected admin access will be needed.</p>
</div></section>
</main>
<script>
(()=>{'use strict';
const $=id=>document.getElementById(id);
const DAYS=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
const SECTIONS=['Produce','Pan 1','Pan 2','Back Shelf','Cooler · Container 1','Cooler · Container 2','Cooler · Other','Cups & Supplies','Other'];
const RAW=[
['pico','Pico','Produce'],['lemons','Lemons','Produce'],['limes','Limes','Produce'],['oranges','Oranges','Produce'],
['tartar','Tartar','Pan 1'],['horseradish','Horseradish','Pan 1'],['lemon-garlic','Lemon garlic','Pan 1'],['sour-cream','Sour cream','Pan 1'],['mayonnaise','Mayonnaise','Pan 1'],['thousand-island','Thousand Island','Pan 1'],
['sriracha','Sriracha','Pan 2'],['cocktail','Cocktail','Pan 2'],['chipotle-ranch','Chipotle ranch','Pan 2'],['honey-mustard','Honey mustard','Pan 2'],['balsamic','Balsamic','Pan 2'],['blue-cheese','Blue cheese','Pan 2'],['whiskey','Whiskey','Pan 2'],['barbecue','Barbecue','Pan 2'],['remy','Remy','Pan 2'],['ranch','Ranch','Pan 2'],
['hot-honey','Hot honey','Back Shelf'],['syrup','Syrup','Back Shelf'],['butter','Butter','Back Shelf'],['caramel','Caramel','Back Shelf'],['sprinkles','Sprinkles','Back Shelf'],['paprika','Paprika','Back Shelf'],['powdered-sugar','Powdered sugar','Back Shelf'],
['red-pepper','Red pepper','Cooler · Container 1'],['pepperoncinis','Pepperoncinis','Cooler · Container 1'],['cucumber','Cucumber','Cooler · Container 1'],['salami','Salami','Cooler · Container 1'],
['lettuce','Lettuce','Cooler · Container 2'],['tomato','Tomato','Cooler · Container 2'],['onion','Onion','Cooler · Container 2'],
['whip-cream','Whip cream','Cooler · Other'],['strawberries','Strawberries','Cooler · Other'],['cottage-cheese','Cottage cheese','Cooler · Other'],['guacamole','Guacamole','Cooler · Other'],['applesauce','Applesauce','Cooler · Other'],['oyster-sets','Oyster sets','Cooler · Other'],['raw-horseradish','Raw horseradish','Cooler · Other'],
['crackers','Crackers','Cups & Supplies'],['wet-naps','Wet naps','Cups & Supplies'],['2oz-paper-cups','2 oz paper cups','Cups & Supplies'],['2oz-plastic-cups','2 oz plastic cups','Cups & Supplies'],['4oz-plastic-cups','4 oz plastic cups','Cups & Supplies'],['2oz-plastic-lids','2 oz plastic cup lids','Cups & Supplies'],['4oz-plastic-lids','4 oz plastic cup lids','Cups & Supplies'],['8oz-paper-cups','8 oz paper cups','Cups & Supplies'],['16oz-paper-cups','16 oz paper cups','Cups & Supplies'],['paper-cup-lids','Paper cup lids','Cups & Supplies']
];
const DEFAULT_ITEMS=RAW.map(([id,name,section])=>({id,name,section,par:'',brunchOnly:false}));
const DEFAULT_DUTIES={AM:{arrival:['Unload cart','Lay mats','Cut lemons'],checkout:[]},PM:{arrival:[],checkout:['Put away mats','Load carts','Stock everything for AM']}};
const PREFIX='expo-prep-v2-';const OLD='expo-prep-v1-';
function read(key,fallback,old=false){try{const s=localStorage.getItem((old?OLD:PREFIX)+key);return s===null?fallback:JSON.parse(s);}catch(e){return fallback;}}
function save(key,value){try{localStorage.setItem(PREFIX+key,JSON.stringify(value));return true;}catch(e){alert('Unable to save in this browser. Your storage might be full, especially if photos have been added.');return false;}}
function clone(x){return JSON.parse(JSON.stringify(x));}
function migrateItems(){const old=read('items',null,true);const already=read('items',null);if(Array.isArray(already))return already;const result=clone(DEFAULT_ITEMS);if(Array.isArray(old)){for(const existing of old){const match=result.find(i=>i.id===existing.id);if(match){match.par=existing.regular||'';}else if(existing.custom){result.push({id:existing.id,name:existing.name,section:SECTIONS.includes(existing.section)?existing.section:'Other',par:existing.regular||'',brunchOnly:false});}}}return result;}
let items=migrateItems();if(!Array.isArray(items))items=clone(DEFAULT_ITEMS);for(const def of DEFAULT_ITEMS){if(!items.some(x=>x.id===def.id))items.push(clone(def));}
// Fixed grouping stays consistent even when an older file saved item locations.
for(const item of items){const def=DEFAULT_ITEMS.find(x=>x.id===item.id);if(def)item.section=def.section;item.brunchOnly=!!item.brunchOnly;if(typeof item.par!=='string')item.par=String(item.par||'');}
// Do not write during startup; full browser storage can otherwise block page loading.
let duties=read('duties',clone(DEFAULT_DUTIES));if(!duties||typeof duties!=='object')duties=clone(DEFAULT_DUTIES);for(const shift of ['AM','PM'])for(const type of ['arrival','checkout'])if(!Array.isArray(duties?.[shift]?.[type])){if(!duties[shift])duties[shift]={};duties[shift][type]=clone(DEFAULT_DUTIES[shift][type]);}
// Keep saved admin duties while removing the two obsolete AM arrival tasks.
duties.AM.arrival=duties.AM.arrival.filter(task=>!['cut cilantro','cut limes'].includes(String(task).trim().toLowerCase()));
// Preserve existing duty edits without an unnecessary startup write.
let selectedDate=new Date();selectedDate.setHours(12,0,0,0);let shift=new Date().getHours()*60+new Date().getMinutes()>=15*60+30?'PM':'AM';let adminDay=selectedDate.getDay();let adminTab='specials';let fromAdmin='list';let done={};
function node(tag,cls,txt){const e=document.createElement(tag);if(cls)e.className=cls;if(txt!==undefined)e.textContent=txt;return e;}
function dateKey(d){return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;}
function monthKey(d){return dateKey(d).slice(0,7);}function checkKey(){return `done-${dateKey(selectedDate)}-${shift}`;}function isBrunch(){return [0,6].includes(selectedDate.getDay());}
function show(screen){for(const s of ['shift','list','admin'])$(s+'-screen').hidden=s!==screen;$('back').hidden=false;window.scrollTo(0,0);}
function chooseDay(day){const today=new Date();today.setHours(12,0,0,0);const diff=((day-today.getDay())+7)%7;selectedDate=new Date(today);selectedDate.setDate(today.getDate()+diff);renderDayButtons();}
function renderDayButtons(){const target=$('day-buttons');target.replaceChildren();for(let i=1;i<=7;i++){const d=i%7;const b=node('button','day'+(selectedDate.getDay()===d?' selected':''),DAYS[d].slice(0,3));b.type='button';b.setAttribute('aria-pressed',String(selectedDate.getDay()===d));b.addEventListener('click',()=>chooseDay(d));target.append(b);}}
function openList(){done=read(checkKey(),{});if(!done||typeof done!=='object')done={};$('shift-title').textContent=DAYS[selectedDate.getDay()]+' · '+shift;$('shift-date').textContent=selectedDate.toLocaleDateString(undefined,{year:'numeric',month:'long',day:'numeric'});renderSpecials();renderTasks();show('list');}
function taskRow(id,text,par){const row=node('label','task'+(done[id]?' checked':''));const box=node('input');box.type='checkbox';box.checked=!!done[id];box.addEventListener('change',()=>{done[id]=box.checked;save(checkKey(),done);row.classList.toggle('checked',box.checked);});row.append(box,node('span','name',text));if(par)row.append(node('span','par',par));return row;}
function renderTasks(){
for(const type of ['arrival','checkout']){
 const target=$(type+'-tasks');target.replaceChildren();const names=duties[shift][type];
 names.forEach((name,i)=>target.append(taskRow('duty-'+type+'-'+i,name,'')));
 // Special prep entries belong in the AM On Arrival checklist for the selected day.
 if(type==='arrival'&&shift==='AM'){
  for(const specialType of ['daily','monthly']){
   const special=getSpecial(specialType,selectedDate.getDay());
   const key=specialType==='daily'?String(selectedDate.getDay()):monthKey(selectedDate);
   const prep=Array.isArray(special.prepItems)?special.prepItems:[];
   prep.forEach((item,i)=>{
    const label=typeof item==='string'?item:item.name;
    if(label)target.append(taskRow('special-duty-'+specialType+'-'+key+'-'+i,label,''));
   });
  }
 }
 if(!target.children.length)target.append(node('div','empty','No duties added yet.'));
}
const target=$('prep-tasks');target.replaceChildren();for(const section of SECTIONS){const filtered=items.filter(item=>item.section===section&&(!item.brunchOnly||isBrunch()));if(!filtered.length)continue;const wrap=node('section','subsection');wrap.append(node('h3','',section));for(const item of filtered)wrap.append(taskRow('prep-'+item.id,item.name,item.par));target.append(wrap);}}
function specialKey(type,day){return type==='daily'?'weekly-special-'+day:'special-monthly-'+monthKey(selectedDate);}
function getSpecial(type,day){const saved=read('special-'+(type==='daily'?day:monthKey(selectedDate)),null);if(saved)return saved;return read(specialKey(type,day),{title:'',description:'',photo:''},true)||{title:'',description:'',photo:''};}
function saveSpecial(type,day,data){return save('special-'+(type==='daily'?day:monthKey(selectedDate)),data);}
function renderSpecials(){for(const type of ['daily','monthly']){
 const target=$(type+'-display');target.replaceChildren();const data=getSpecial(type,selectedDate.getDay());
 target.append(node('div','heading',type==='daily'?'Daily Special':'Monthly Special'));
 if(data.photo){const img=node('img');img.src=data.photo;img.alt='Photo of '+(data.title||'special');target.append(img);}
 if(data.title)target.append(node('h3','',data.title));if(data.description)target.append(node('p','',data.description));
 const prep=Array.isArray(data.prepItems)?data.prepItems:[];
 if(prep.length){const label=node('h3','','Prep items');target.append(label);const ul=node('ul','special-prep-list');for(const item of prep){const li=node('li','',typeof item==='string'?item:item.name);ul.append(li);}target.append(ul);}
 if(!data.title&&!data.description&&!data.photo&&!prep.length)target.append(node('div','empty','No special added yet.'));
}}
function photoToData(file){return new Promise((resolve,reject)=>{const fr=new FileReader();fr.onerror=reject;fr.onload=()=>{const img=new Image();img.onerror=reject;img.onload=()=>{const scale=Math.min(1,1000/Math.max(img.width,img.height));const canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(img.width*scale));canvas.height=Math.max(1,Math.round(img.height*scale));canvas.getContext('2d').drawImage(img,0,0,canvas.width,canvas.height);resolve(canvas.toDataURL('image/jpeg',.68));};img.src=fr.result;};fr.readAsDataURL(file);});}
function renderSpecialEditor(type,targetId,day){
 const target=$(targetId);target.replaceChildren();const s=getSpecial(type,day);
 const wrap=node('div','admin-card');wrap.append(node('h3','',type==='daily'?DAYS[day]+' Special':'Monthly Special'));
 const tlabel=node('label','','Title'),title=node('input','field');title.value=s.title||'';title.placeholder='Special name';title.maxLength=120;wrap.append(tlabel,title);
 const dlabel=node('label','','Description'),desc=node('textarea','field');desc.value=s.description||'';desc.placeholder='Description or ingredients';wrap.append(dlabel,desc);
 const plabel=node('label','','Picture'),input=node('input','field');input.type='file';input.accept='image/*';wrap.append(plabel,input);
 if(s.photo){const img=node('img');img.src=s.photo;img.alt='Current special photo';wrap.append(img);}
 // Each new prep item exposes a fresh blank field for the next item.
 wrap.append(node('label','','Special prep items'));
 wrap.append(node('p','small muted','These appear under this special and in AM → On Arrival.'));
 const prepWrap=node('div');wrap.append(prepWrap);
 let prepItems=(Array.isArray(s.prepItems)?s.prepItems:[]).map(v=>typeof v==='string'?v:v.name).filter(Boolean);
 function showPrepFields(){
  prepWrap.replaceChildren();
  prepItems.forEach((text,i)=>{
   const r=node('div','special-prep-row');const field=node('input','field');field.value=text;field.placeholder='Prep item '+(i+1);field.maxLength=110;
   field.addEventListener('input',()=>{prepItems[i]=field.value;});
   const del=node('button','btn tiny','Remove');del.type='button';del.addEventListener('click',()=>{prepItems.splice(i,1);showPrepFields();});
   r.append(field,del);prepWrap.append(r);
  });
  const actions=node('div','actions');const add=node('button','btn tiny dark',prepItems.length?'+ Add another':'+ Add prep item');add.type='button';
  add.addEventListener('click',()=>{prepItems.push('');showPrepFields();const inputs=prepWrap.querySelectorAll('input');inputs[inputs.length-1]?.focus();});
  actions.append(add);prepWrap.append(actions);
 }
 showPrepFields();
 const specialData=photo=>({title:title.value.trim(),description:desc.value.trim(),photo,prepItems:prepItems.map(x=>x.trim()).filter(Boolean)});
 const buttons=node('div','actions'),store=node('button','btn red','Save special'),remove=node('button','btn','Remove picture');remove.disabled=!s.photo;
 store.addEventListener('click',async()=>{let photo=s.photo||'';if(input.files?.[0]){try{photo=await photoToData(input.files[0]);}catch(e){alert('Unable to read this picture.');return;}}if(saveSpecial(type,day,specialData(photo))){renderSpecialEditor(type,targetId,day);renderSpecials();renderTasks();}});
 remove.addEventListener('click',()=>{if(saveSpecial(type,day,specialData(''))){renderSpecialEditor(type,targetId,day);renderSpecials();renderTasks();}});
 buttons.append(store,remove);wrap.append(buttons);target.append(wrap);
}
function renderAdminDays(){const target=$('admin-days');target.replaceChildren();for(let i=1;i<=7;i++){const d=i%7;const b=node('button','day'+(adminDay===d?' selected':''),DAYS[d].slice(0,3));b.type='button';b.addEventListener('click',()=>{adminDay=d;renderAdminDays();renderSpecialEditor('daily','daily-editor',d);});target.append(b);}}
function openAdmin(source){fromAdmin=source;renderAdmin();show('admin');}
function renderAdmin(){renderTab();renderAdminDays();$('month-title').textContent='Monthly Special · '+selectedDate.toLocaleDateString(undefined,{month:'long',year:'numeric'});renderSpecialEditor('daily','daily-editor',adminDay);renderSpecialEditor('monthly','monthly-editor',adminDay);renderPrepEditor();renderDutyEditor();}
function renderTab(){for(const t of ['specials','prep','duties']){$('admin-'+t).hidden=t!==adminTab;const b=document.querySelector('[data-admin-tab="'+t+'"]');b.classList.toggle('dark',t===adminTab);}}
function renderPrepEditor(){const target=$('prep-editor');target.replaceChildren();for(const section of SECTIONS){const subset=items.filter(i=>i.section===section);if(!subset.length)continue;target.append(node('h3','',section));for(const item of subset){const wrap=node('div','item-edit');wrap.append(node('strong','',item.name));const fields=node('div','form-grid');const nameLabel=node('label','','Item name'),name=node('input','field');name.value=item.name;name.maxLength=100;nameLabel.append(name);const parLabel=node('label','','Par'),par=node('input','field');par.value=item.par||'';par.maxLength=45;par.placeholder='Optional';parLabel.append(par);fields.append(nameLabel,parLabel);wrap.append(fields);
const brunchLabel=node('label','checkrow'),brunch=node('input');brunch.type='checkbox';brunch.checked=!!item.brunchOnly;brunchLabel.append(brunch,node('span','','Brunch only (Sat–Sun)'));wrap.append(brunchLabel);
const actions=node('div','actions'),saveButton=node('button','btn tiny dark','Save'),deleteButton=node('button','btn tiny','Remove');
saveButton.addEventListener('click',()=>{item.name=name.value.trim()||item.name;item.par=par.value.trim();item.brunchOnly=brunch.checked;if(save('items',items)){renderPrepEditor();renderTasks();}});
deleteButton.addEventListener('click',()=>{if(confirm('Remove '+item.name+'?')){items=items.filter(x=>x.id!==item.id);if(save('items',items)){renderPrepEditor();renderTasks();}}});actions.append(saveButton,deleteButton);wrap.append(actions);target.append(wrap);}}}
function addItem(){const name=$('new-item-name').value.trim();if(!name){$('new-item-name').focus();return;}items.push({id:'added-'+Date.now()+'-'+Math.random().toString(36).slice(2,6),name,section:$('new-item-section').value,par:$('new-item-par').value.trim(),brunchOnly:$('new-item-brunch').checked});if(save('items',items)){$('new-item-name').value='';$('new-item-par').value='';$('new-item-brunch').checked=false;renderPrepEditor();renderTasks();}}
function renderDutyEditor(){const sh=$('duties-shift').value,kind=$('duties-type').value;const target=$('duty-editor');target.replaceChildren();const tasks=duties[sh][kind];if(!tasks.length)target.append(node('p','empty','No tasks yet.'));tasks.forEach((task,i)=>{const row=node('div','item-edit'),field=node('input','field');field.value=task;field.maxLength=110;const actions=node('div','actions'),saveB=node('button','btn tiny dark','Save'),delB=node('button','btn tiny','Remove');saveB.addEventListener('click',()=>{if(!field.value.trim())return;duties[sh][kind][i]=field.value.trim();save('duties',duties);renderDutyEditor();renderTasks();});delB.addEventListener('click',()=>{duties[sh][kind].splice(i,1);save('duties',duties);renderDutyEditor();renderTasks();});actions.append(saveB,delB);row.append(field,actions);target.append(row);});}
function addDuty(){const t=$('new-duty').value.trim();if(!t)return;duties[$('duties-shift').value][$('duties-type').value].push(t);if(save('duties',duties)){$('new-duty').value='';renderDutyEditor();renderTasks();}}
for(const s of SECTIONS){const op=node('option','',s);op.value=s;$('new-item-section').append(op);}
document.querySelectorAll('[data-select-shift]').forEach(b=>b.addEventListener('click',()=>{shift=b.dataset.selectShift;openList();}));
$('change-shift').addEventListener('click',()=>{renderDayButtons();show('shift');});
$('back').addEventListener('click',()=>{if(!$('admin-screen').hidden){if(fromAdmin==='list')openList();else{renderDayButtons();show('shift');}}else if(!$('shift-screen').hidden)openList();else if(!$('list-screen').hidden){renderDayButtons();show('shift');}});
$('admin-from-picker').addEventListener('click',()=>openAdmin('shift'));
$('admin-from-list').addEventListener('click',()=>openAdmin('list'));
$('admin-done').addEventListener('click',()=>{if(fromAdmin==='shift'){renderDayButtons();show('shift');}else openList();});
document.querySelectorAll('[data-admin-tab]').forEach(b=>b.addEventListener('click',()=>{adminTab=b.dataset.adminTab;renderTab();}));
$('add-item').addEventListener('click',addItem);$('add-duty').addEventListener('click',addDuty);
$('duties-shift').addEventListener('change',renderDutyEditor);$('duties-type').addEventListener('change',renderDutyEditor);
$('clear-checks').addEventListener('click',()=>{if(confirm('Clear all checkmarks for this day and shift?')){done={};save(checkKey(),done);renderTasks();}});
renderDayButtons();openList();
})();
</script>
</body>
</html>
