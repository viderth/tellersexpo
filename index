{border:2px solid #222;border-radius:11px;background:#222;color:#fff;padding:20px 8px;font-size:24px;font-weight:850}.shift-opt span{display:block;font-size:12px;font-weight:500;margin-top:5px;color:#ddd}
details.panel{padding:0;overflow:hidden}details.panel>summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px;background:#eeeeee;font-size:20px;font-weight:850;cursor:pointer}details.panel>summary::-webkit-details-marker{display:none}details.panel>summary:after{content:'+';font-size:25px;line-height:1;color:#333}details.panel[open]>summary:after{content:'−'}.inner{padding:15px}.special-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.special{border:1px solid var(--line);border-radius:10px;padding:12px;min-width:0}.special .heading{font-weight:850;font-size:16px}.special h3{margin:10px 0 6px;font-size:17px}.special p{margin:8px 0;white-space:pre-wrap;overflow-wrap:anywhere}.special img{display:block;width:100%;max-height:290px;object-fit:cover;border-radius:8px;margin:9px 0}.subsection{padding:4px 0 14px}.subsection:last-child{padding-bottom:0}.subsection h3{font-size:17px;border-left:4px solid var(--red);padding-left:9px;margin:6px 0 11px}.task{display:flex;gap:12px;align-items:center;padding:11px 0;border-top:1px solid #eee;min-height:48px;cursor:pointer}.task input{height:23px;width:23px;accent-color:var(--red);flex:none;margin:0}.task .name{flex:1}.task.checked .name{text-decoration:line-through;color:#888}.par{background:#ececec;border-radius:5px;padding:3px 7px;font-size:12px;font-weight:750;white-space:nowrap}.empty{padding:8px 0;color:#777;font-size:14px}.admin-nav{display:flex;gap:8px;flex-wrap:wrap;margin:13px 0}.admin-section{border-top:1px solid #ddd;padding-top:15px;margin-top:15px}.admin-card{border:1px solid #d6d6d6;border-radius:10px;padding:13px;margin:10px 0;background:#fafafa}.admin-card h3{margin:0 0 10px;font-size:17px}.admin-card label:not(.checkrow){display:block;margin:12px 0 5px;font-size:13px;font-weight:800}.admin-card textarea{min-height:90px;resize:vertical}.admin-card img{display:block;width:100%;max-height:240px;object-fit:contain;margin:10px 0;border-radius:8px}.checkrow{display:flex;align-items:center;gap:8px;margin-top:12px;font-size:14px;font-weight:700}.checkrow input{width:19px;height:19px;accent-color:var(--red)}.item-edit{border-top:1px solid #ddd;padding:13px 0}.item-edit:first-of-type{border-top:0}.item-edit strong{display:block;margin-bottom:8px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.form-grid label{font-size:12px;font-weight:750;color:var(--muted)}.form-grid label .field{margin-top:4px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:11px}.notice{font-size:12px;line-height:1.55;color:#555;margin:13px 0}.pill{display:inline-block;background:#ffeded;color:#9e2028;font-size:11px;font-weight:800;padding:3px 7px;border-radius:30px;margin-left:7px}.toolbar{display:flex;gap:7px;flex-wrap:wrap}.admin-tabs{margin:10px 0}.two-columns{display:grid;grid-template-columns:1fr 1fr;gap:8px}.special-prep-row{display:flex;gap:8px;align-items:center;margin:8px 0}.special-prep-row .field{flex:1;min-width:0}.special-prep-list{padding-left:22px;margin:7px 0}
@media(max-width:560px){header{padding:12px}.brand{font-size:19px}.container{padding:12px 9px 35px}.panel{padding:13px}.inner{padding:13px}.special-grid{grid-template-columns:1fr}.day{font-size:12px;min-height:44px}.form-grid{grid-template-columns:1fr 1fr}.controls{grid-template-columns:1fr 1fr}}
</style>
